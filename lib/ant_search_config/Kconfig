menuconfig ANT_SEARCH_CONFIG
	bool "ANT Search Config Library"
	help
	  Helper functions for ANT search configuration

if ANT_SEARCH_CONFIG

module=ANT_SEARCH_CONFIG
module-str=ANT Search Config
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

config ANT_LOW_PRIORITY_TIMEOUT
	int "Low priority search timeout"
	default 2

config ANT_HIGH_PRIORITY_TIMEOUT
	int "High priority search timeout"
	default 10

endif # ANT_SEARCH_CONFIG
