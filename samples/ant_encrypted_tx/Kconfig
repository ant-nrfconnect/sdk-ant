source "Kconfig.zephyr"

menuconfig MULTI_CHANNELS_ENCRYPTED_TX
	bool "ANT Multi-channels Encrypted TX sample"
	select ANT
	select ANT_CHANNEL_CONFIG
	select ANT_ENCRYPT_CONFIG
	select ANT_STATE_INDICATOR
	select DK_LIBRARY
	default y

menu "Channel configuration"

config ID_DEV_TYPE
	int "Channel ID: Device type"
	default 2
	range 0 127

config ID_TRANS_TYPE
	int "Channel ID: Transmission type"
	default 1
	range 0 255

config CHAN_PERIOD
	int "Channel Period"
	default 8192
	range 0 65535

config RF_FREQ
	int "Radio Frequency"
	default 66

endmenu
