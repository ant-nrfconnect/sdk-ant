source "Kconfig.zephyr"

menuconfig BPWR_TX
	bool "ANT+ Bicycle Power TX sample"
	select ANT
	select ANT_BPWR
	select ANT_BPWR_SIMULATOR
	select ANT_KEY_MANAGER
	select ANT_CHANNEL_CONFIG
	select ANT_STATE_INDICATOR
	select DK_LIBRARY
	default y

menu "Channel configuration"

config BPWR_TX_CHANNEL_NUM
	int "Channel number assigned to BPWR profile"
	default 0

config BPWR_TX_NETWORK_NUM
	int "ANT+ Network number"
	default 0
	help
	  Selects the network number to associate with the channel.

config BPWR_TX_CHAN_ID_DEV_NUM
	int "Channel ID: Device number"
	default 49
	range 0 65535

config BPWR_TX_CHAN_ID_TRANS_TYPE
	int "Channel ID: Transmission type"
	default 5
	range 0 255

config BPWR_TX_CALIBRATION_DATA
	int "Calibration data"
	default 21930

endmenu

menu "Product information"

config BPWR_TX_HW_VERSION
	int "Hardware revision"
	default 5
	range 0 255

config BPWR_TX_MFG_ID
	int "Manufacturer ID"
	default 2
	range 0 255

config BPWR_TX_MODEL_NUM
	int "Model number"
	default 2
	range 0 255

config BPWR_TX_SW_VERSION
	int "Software version"
	default 0
	range 0 255

config BPWR_TX_SERIAL_NUM
	int "Serial number"
	default 43981
	range 0 65535

endmenu

menu "User interface"

choice BPWR_TX_MODIFICATION_TYPE
	default UPDATE_AUTO
	prompt "Method for updating Bike Power values"

config UPDATE_AUTO
	bool "AUTO"
	help
	  Automatically sweep through a range of values.

config UPDATE_MANUAL
	bool "MANUAL (Buttons)"
	help
	  Use Button 1 to decrease and Button 2 to increase value.

endchoice


menu "Bicycle power sensor"

config SENSOR_TYPE
	int "Type of sensor (data transmitted)"
	default 1
	range 0 255
	help
		Power sensor  =>  1   (Transmit Power data)
		Wheel Torque sensor  =>  2   (Transmit Wheel Torque data)
		Crank Torque sensor  =>  3   (Transmit Crank Torque data)

endmenu

endmenu