source "Kconfig.zephyr"

menuconfig BSC_RX
	bool "ANT+ Bicycle Speed and Cadence RX sample"
	select ANT
	select ANT_BSC
	select ANT_KEY_MANAGER
	select ANT_CHANNEL_CONFIG
	select ANT_STATE_INDICATOR
	select DK_LIBRARY
	default y

menu "Channel configuration"

config BSC_RX_CHANNEL_NUM
	int "Channel number assigned to BSC profile"
	default 0

config BSC_RX_NETWORK_NUM
	int "ANT+ Network number"
	default 0
	help
	  Selects the network number to associate with the channel.

config BSC_RX_CHAN_ID_DEV_NUM
	int "Channel ID: Device number"
	default 49
	range 0 65535

config BSC_RX_CHAN_ID_TRANS_TYPE
	int "Channel ID: Transmission type"
	default 1
	range 0 255

config BSC_RX_DISPLAY_TYPE
	int "Type of data that is received"
	default 121
	range 0 255
	help
		Combined Speed and Cadence data  =>  121
		Cadence data  =>  122
		Speed data  =>  123

endmenu