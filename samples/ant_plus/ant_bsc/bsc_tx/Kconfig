source "Kconfig.zephyr"

menuconfig BSC_TX
	bool "ANT+ Bicycle Speed and Cadence TX sample"
	select ANT
	select ANT_BSC
	select ANT_BSC_SIMULATOR
	select ANT_KEY_MANAGER
	select ANT_CHANNEL_CONFIG
	select ANT_STATE_INDICATOR
	select DK_LIBRARY
	default y

menu "Channel configuration"

config BSC_TX_CHANNEL_NUM
	int "Channel number assigned to BSC profile"
	default 0

config BSC_TX_NETWORK_NUM
	int "ANT+ Network number"
	default 0
	help
	  Selects the network number to associate with the channel.

config BSC_TX_CHAN_ID_DEV_NUM
	int "Channel ID: Device number"
	default 49
	range 0 65535

config BSC_TX_CHAN_ID_TRANS_TYPE
	int "Channel ID: Transmission type"
	default 1
	range 0 255

endmenu

menu "Product information"

config BSC_TX_HW_VERSION
	int "Hardware revision"
	default 5
	range 0 255

config BSC_TX_MFG_ID
	int "Manufacturer ID"
	default 2
	range 0 255

config BSC_TX_MODEL_NUM
	int "Model number"
	default 2
	range 0 255

config BSC_TX_SW_VERSION
	int "Software version"
	default 0
	range 0 255

config BSC_TX_SERIAL_NUM
	int "Serial number"
	default 43981
	range 0 65535

endmenu

menu "User interface"

choice BSC_TX_MODIFICATION_TYPE
	default UPDATE_AUTO
	prompt "Method for updating Speed and Cadence values"

config UPDATE_AUTO
	bool "AUTO"
	help
	  Automatically sweep through a range of values.

config UPDATE_MANUAL
	bool "MANUAL (Buttons)"
	help
	  Pressing Button 1 stops increases in the speed/cadence values, pressing Button 2 starts increasing the speed/cadence values.

endchoice

menu "Bicycle speed and cadence sensor"

config SENSOR_TYPE
	int "Type of sensor (data transmitted)"
	default 121
	range 0 255
	help
		Speed and Cadence sensor  =>  121   (Transmit Combined Speed and Cadence data)
		Cadence sensor  =>  122   (Transmit Cadence data only)
		Speed sensor  =>  123   (Transmit Speed data only)

endmenu

endmenu
