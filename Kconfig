menu "ANT Wireless"

config ANT
    bool "ANT Wireless"
    depends on (SOC_NRF5340_CPUNET || SOC_NRF5340_CPUAPP || SOC_NRF52840)
    help
       Enable ANT ultra low power wireless protocol by Garmin Canada Inc.

if ANT

config ANT_LIBRARY_CORE
    bool "Defines the core used for ANT radio communication"
    select NRFX_PPI if HAS_HW_NRF_PPI
    select NRFX_DPPI if HAS_HW_NRF_DPPIC
    # include multiprotocol service layer (MPSL):
    #   - ANT stack radio scheduling access via radio event manager (REM)
    select MPSL
    # include entropy:
    #  - ANT stack encrypted channel support using random number for cryptographic services
    select ENTROPY_GENERATOR
    default n if (SOC_NRF5340_CPUAPP)
    default y
    help
      This configuration is required for all single core builds and for network core builds on dual-core systems.

config ANT_INTERNAL
    bool "ANT Internal"
    default n

rsource "init/Kconfig"
rsource "lib/Kconfig"
rsource "np/Kconfig"
rsource "samples/Kconfig"

endif # ANT

endmenu